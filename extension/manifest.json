{
  "manifest_version": 3,
  "name": "Notes2TeX — 1-Click Overleaf LaTeX Injector",
  "version": "1.0.0",
  "description": "Upload handwritten notes or PDFs to automatically compile LaTeX & TikZ and inject directly into Overleaf.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.overleaf.com/project/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
