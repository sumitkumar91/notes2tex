{
  "manifest_version": 3,
  "name": "Board2TeX — 1-Click Overleaf LaTeX Injector",
  "version": "1.0.0",
  "description": "Snap a screenshot of any handwritten note or whiteboard and automatically inject compiled LaTeX & TikZ into Overleaf.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.overleaf.com/*",
    "http://127.0.0.1:8008/*",
    "http://localhost:8008/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.overleaf.com/project/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "snip_to_overleaf": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Snip area and inject to Overleaf"
    }
  }
}
